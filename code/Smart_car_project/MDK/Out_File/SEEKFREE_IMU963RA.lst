             -------------
  385          static void imu963ra_simspi_w_reg_byte(uint8 cmd, uint8 val)
  386          {
  387   1          IMU963RA_CS(0);
  388   1          cmd |= IMU963RA_SPI_W;
  389   1          imu963ra_simspi_wr_byte(cmd);                       
  390   1          imu963ra_simspi_wr_byte(val);                                       
  391   1          IMU963RA_CS(1);                                     
  392   1      }
