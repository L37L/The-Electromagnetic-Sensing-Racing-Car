  355          //  @brief      通过SPI写一个byte,同时读取一个byte
  356          //  @param      byte        发送的数据    
  357          //  @return     uint8       return 返回status状态
  358          //  @since      v1.0
C251 COMPILER V5.60.0,  SEEKFREE_IMU963RA                                                  27/03/26  11:12:42  PAGE 7   

  359          //  Sample usage:
  360          //-------------------------------------------------------------------------------------------------------
             -------------
  361          static uint8 imu963ra_simspi_wr_byte(uint8 byte)
  362          {
  363   1          uint8 i;
  364   1              
  365   1          for(i=0; i<8; i++)
  366   1          {
  367   2              IMU963RA_MOSI(byte&0x80);
  368   2              byte <<= 1;
  369   2                      IMU963RA_SCK (0);
  370   2                      IMU963RA_SCK (0);
  371   2                      
  372   2                      IMU963RA_SCK (1);
  373   2                      IMU963RA_SCK (1);
  374   2                      byte |= IMU963RA_MISO; 
  375   2          }   
  376   1          return(byte);                                               
  377   1      }
