   90          static void imu660ra_simiic_delay(void)
   91          {
   92   1          uint16 j=IMU660RA_SOFT_IIC_DELAY;   
   93   1              while(j--);
   94   1      }
   95          
   96          //内部使用，用户无需调用
   97          static void imu660ra_simiic_start(void)
   98          {
   99   1              IMU660RA_SDA_HIGH();
