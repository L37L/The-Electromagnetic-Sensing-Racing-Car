  482          static uint8 imu660ra_self_check (void)
  483          {
  484   1          uint8 dat = 0, return_state = 0;
  485   1          uint16 timeout_count = 0;
  486   1          do
  487   1          {
  488   2              if(timeout_count ++ > IMU660RA_TIMEOUT_COUNT)
  489   2              {
  490   3                  return_state =  1;
