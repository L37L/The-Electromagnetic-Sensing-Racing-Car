               static uint8 imu660ra_read_register(uint8 reg)
               {
                   uint8 dat[2];
                   IMU660RA_CS(0);
                   imu660ra_simspi_r_reg_bytes(reg | IMU660RA_SPI_R, dat, 2);
                   IMU660RA_CS(1);
                   return dat[1];
