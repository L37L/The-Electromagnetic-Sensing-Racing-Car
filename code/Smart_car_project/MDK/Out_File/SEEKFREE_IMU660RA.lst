               static void imu660ra_read_registers(uint8 reg, uint8 *dat, uint32 len)
               {
                   IMU660RA_CS(0);
                   imu660ra_simspi_r_reg_bytes(reg | IMU660RA_SPI_R, dat, len);
                       IMU660RA_CS(1);
               }
