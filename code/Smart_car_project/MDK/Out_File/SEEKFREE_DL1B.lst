  131   1          if(GET_DL1B_SDA)           //应答为高电平，异常，通信失败
  132   1          {
  133   2      
  134   2              DL1B_SCL_LOW();
  135   2              return 0;
  136   2          }
  137   1      
  138   1          DL1B_SCL_LOW();
