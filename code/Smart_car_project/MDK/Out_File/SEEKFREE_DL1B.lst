   72          //  @brief      模拟IIC延时
   73          //  @return     void                                            
   74          //  @since      v1.0
   75          //  Sample usage:                               如果IIC通讯失败可以尝试增加j的值
   76          //-------------------------------------------------------------------------------------------------------
             -------------
   77          static void dl1b_simiic_delay(void)
   78          {
   79   1          uint16 j=DL1B_SOFT_IIC_DELAY;   
   80   1              while(j--);
   81   1      }
   82          
   83          //内部使用，用户无需调用
   84          static void dl1b_simiic_start(void)
   85          {
   86   1              DL1B_SDA_HIGH();
   87   1              DL1B_SCL_HIGH();
   88   1              dl1b_simiic_delay();
   89   1              DL1B_SDA_LOW();
   90   1              dl1b_simiic_delay();
   91   1              DL1B_SCL_LOW();
   92   1      }
   93          
   94          //内部使用，用户无需调用
   95          static void dl1b_simiic_stop(void)
   96          {
   97   1              DL1B_SDA_LOW();
   98   1              DL1B_SCL_LOW();
   99   1              dl1b_simiic_delay();
  100   1              DL1B_SCL_HIGH();
  101   1              dl1b_simiic_delay();
  102   1              DL1B_SDA_HIGH();
  103   1              dl1b_simiic_delay();
  104   1      }
  105          
  106          //主应答(包含ack:SDA=0和no_ack:SDA=0)
  107          //内部使用，用户无需调用
  108          static void dl1b_simiic_sendack(unsigned char ack_dat)
  109          {
  110   1          DL1B_SCL_LOW();
  111   1              dl1b_simiic_delay();
  112   1              if(ack_dat) DL1B_SDA_LOW();
  113   1          else        DL1B_SDA_HIGH();
  114   1      
  115   1          DL1B_SCL_HIGH();
  116   1          dl1b_simiic_delay();
