  335   3                  data_buffer[1] = DL1B_GPIO__TIO_HV_STATUS & 0xFF;
  336   3                  dl1b_transfer_8bit_array(data_buffer, 2, &data_buffer[2], 1);
  337   3                  if(0x00 == (data_buffer[2] & 0x01))
  338   3                  {
  339   4                      time_out_count = 0;
  340   4                      break;
  341   4                  }
  342   3                  if(DL1B_TIMEOUT_COUNT < time_out_count ++)
  343   3                  {
  344   4                      return_state = 1;
  345   4                      break;
  346   4                  }
  347   3                  delay_ms(1);
  348   3              }
  349   2      
  350   2              dl1b_init_flag = 1;
  351   2          }while(0);
  352   1      
  353   1      
  354   1          return return_state;
  355   1      }


