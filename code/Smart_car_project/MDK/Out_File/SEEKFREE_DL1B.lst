  198          //-------------------------------------------------------------------------------------------------------
             -------------
  199          // 函数简介     软件 IIC 接口传输 8bit 数组 先写后读取
  200          // 参数说明     *write_data     发送数据存放缓冲区
  201          // 参数说明     write_len       发送缓冲区长度
  202          // 参数说明     *read_data      读取数据存放缓冲区
  203          // 参数说明     read_len        读取缓冲区长度
  204          // 返回参数     void            
  205          // 使用示例     iic_transfer_8bit_array(IIC_1, addr, data, 64, data, 64);
  206          // 备注信息     
  207          //-------------------------------------------------------------------------------------------------------
             -------------
  208          void dl1b_iic_transfer_8bit_array (const uint8 *write_data, uint32 write_len, uint8 *read_data, uint32 re
             -ad_len)
  209          {
  210   1      
  211   1          dl1b_simiic_start();
  212   1          dl1b_send_ch(DL1B_DEV_ADDR << 1);
  213   1          while(write_len --)
  214   1          {
  215   2              dl1b_send_ch(*write_data ++);
  216   2          }
  217   1          dl1b_simiic_start();
  218   1          dl1b_send_ch(DL1B_DEV_ADDR << 1 | 0x01);
  219   1          while(read_len --)
  220   1          {
  221   2                      // 前面7位需要回复ack，最后1位不需要回复ack.
  222   2              *read_data ++ = dl1b_read_ch(read_len != 0);
  223   2          }
  224   1          dl1b_simiic_stop();
  225   1      }
