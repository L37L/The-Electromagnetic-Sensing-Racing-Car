  143          //字节发送程序
  144          //发送c(可以是数据也可是地址)，送完后接收从应答
  145          //不考虑从应答位
  146          //内部使用，用户无需调用
  147          static void dl1b_send_ch(uint8 c)
  148          {
  149   1              uint8 i = 8;
  150   1          while(i--)
  151   1          {
  152   2              if(c & 0x80)    DL1B_SDA_HIGH();//SDA 输出数据
  153   2              else                    DL1B_SDA_LOW();
  154   2              c <<= 1;
  155   2              dl1b_simiic_delay();
  156   2              DL1B_SCL_HIGH();                //SCL 拉高，采集信号
  157   2              dl1b_simiic_delay();
  158   2              DL1B_SCL_LOW();                //SCL 时钟线拉低
  159   2          }
  160   1              dl1b_sccb_waitack();
  161   1      }
  162          
  163          
  164          //字节接收程序
  165          //接收器件传来的数据，此程序应配合|主应答函数|使用
  166          //内部使用，用户无需调用
  167          static uint8 dl1b_read_ch(uint8 ack_x)
  168          {
  169   1          uint8 i;
  170   1          uint8 c;
  171   1          c=0;
  172   1          DL1B_SCL_LOW();
  173   1          dl1b_simiic_delay();
  174   1          DL1B_SDA_HIGH();             
  175   1      
  176   1          for(i=0;i<8;i++)
  177   1          {
  178   2              dl1b_simiic_delay();
  179   2              DL1B_SCL_LOW();         //置时钟线为低，准备接收数据位
  180   2              dl1b_simiic_delay();
  181   2              DL1B_SCL_HIGH();         //置时钟线为高，使数据线上数据有效
  182   2              dl1b_simiic_delay();
C251 COMPILER V5.60.0,  SEEKFREE_DL1B                                                      27/03/26  11:12:41  PAGE 4   

  183   2              c<<=1;
  184   2              if(GET_DL1B_SDA) 
  185   2              {
  186   3                  c+=1;   //读数据位，将接收的数据存c
  187   3              }
  188   2          }
  189   1      
  190   1              DL1B_SCL_LOW();
  191   1              dl1b_simiic_delay();
  192   1              dl1b_simiic_sendack(ack_x);
  193   1              
  194   1          return c;
  195   1      }
