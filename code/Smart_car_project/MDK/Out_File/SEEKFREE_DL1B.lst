  264   4                      data_buffer[1] = DL1B_RESULT__FINAL_CROSSTALK_CORRECTED_RANGE_MM_SD0 & 0xFF;
  265   4                      dl1b_transfer_8bit_array(data_buffer, 2, data_buffer, 2);
  266   4                      dl1b_distance_temp = data_buffer[0];
  267   4                      dl1b_distance_temp = (dl1b_distance_temp << 8) | data_buffer[1];
  268   4                      
  269   4                      if(dl1b_distance_temp > 4000 || dl1b_distance_temp < 0)
  270   4                      {
  271   5                          dl1b_distance_mm = 8192;
  272   5                          dl1b_finsh_flag = 0;
  273   5                      }
  274   4                      else
  275   4                      {
  276   5                          dl1b_distance_mm = dl1b_distance_temp;
  277   5                          dl1b_finsh_flag = 1;
  278   5                      }
  279   4                  }
  280   3                  else
  281   3                  {
  282   4                      dl1b_distance_mm = 8192;
  283   4                      dl1b_finsh_flag = 0;
  284   4                  }
  285   3              }
  286   2              else
  287   2              {
  288   3                  dl1b_distance_mm = 8192;
  289   3                  dl1b_finsh_flag = 0;
  290   3              }
  291   2          }
  292   1      }
